# Copy to .env next to the compose files to override the defaults

# Image, e.g. a pinned release or a local build
# NTP_EXPORTER_IMAGE=ghcr.io/maximewewer/ntp-exporter:2026.10.1

# Listen port on the host
# NTP_EXPORTER_PORT=9559

# Comma-separated servers: host, host:port or nts://host[:port]
# NTP_EXPORTER_SERVERS=ptbtime1.ptb.de,ptbtime2.ptb.de,ptbtime3.ptb.de

# Timeout of one query
# NTP_EXPORTER_TIMEOUT=2s

# Agent mode options
# NTP_EXPORTER_KERNEL_ENABLED=true
# NTP_EXPORTER_CHRONY_ENABLED=false
# NODE_NAME=my-host

# Constant labels added to every series, key=value,...
# NTP_EXPORTER_METRICS_LABELS=site=paris,env=prod

# debug, info, warn or error
# NTP_EXPORTER_LOG_LEVEL=info
